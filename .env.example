# ═════════════════════════════════════════════════════════════════════════════
# UniFlow Finance — Docker Environment Variables (docker-first)
# Copy this file to `.env` and fill in your values, then run:
#   docker compose up --build -d
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 1. HOST PORTS (what you type in your browser)
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=5050

# ─────────────────────────────────────────────────────────────────────────────
# 2. AI PROVIDER (Groq is the default — fastest & cheapest)
#    Get a free key at https://console.groq.com/
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMMA_MODEL=openai/gpt-oss-120b

# ─────────────────────────────────────────────────────────────────────────────
# 3. BACKEND-SPECIFIC OVERRIDES (loaded from backend/.env)
#    Keep these here too if you want a single source of truth:
# ─────────────────────────────────────────────────────────────────────────────
# GEMMA_PROVIDER=groq
# GEMMA_API_KEY=your_groq_api_key_here
# PORT=5000
# DB_STORAGE=/app/data/database.sqlite
# NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# 4. DEPLOYMENT
#    Set to "true" if running behind a reverse proxy (Traefik, Nginx Proxy, etc.)
# ─────────────────────────────────────────────────────────────────────────────
# TRUST_PROXY=true
