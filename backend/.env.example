# ═════════════════════════════════════════════════════════════════════════════
# UniFlow Finance — Backend Environment (docker-first)
# These override values from the root .env when running under Docker.
# ═════════════════════════════════════════════════════════════════════════════

# AI (defaults come from root .env; uncomment to override per-backend)
# GEMMA_PROVIDER=groq
# GEMMA_API_KEY=your_groq_api_key_here
# GEMMA_MODEL=openai/gpt-oss-120b

# Server (PORT=5000 matches the Dockerfile EXPOSE and nginx proxy_pass)
PORT=5000

# Database (SQLite file inside the container's persistent volume)
DB_STORAGE=/app/data/database.sqlite

# Node environment
NODE_ENV=production
